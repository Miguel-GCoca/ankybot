<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematron="http://download.ros.org/schema/package_format3.xsd"?>
<package format="3">
  <name>ankybot_policy_runner</name>
  <version>0.3.6</version>
  <description>ONNX RL locomotion policy runner for Ankybot quadruped (open-loop, IMU + cmd_vel in, servo degrees out)</description>
  <maintainer email="you@example.com">mingus</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>

  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-onnxruntime</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
